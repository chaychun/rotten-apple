mail_new = "Within today, I request six butterflies. Don't ask why or I won't be so kind. Mess it up and I'll give you a piece of my mind. So grind, that's how you shine."
mail_retry_unsubmitted = "Read my letters! You ignore me again and you'll never again enjoy your taters. I need six butterflies now, not later. Now go gather them you catcher!"
mail_retry_wrong = "Have you gone mad? This lad! I didn't ask for these buttery rats, I don't ask for that. I need six butterflies, flat. No more, no less. Start now, work in progress."
mail_reward = "Job wonderfully done! My butterfly collection has begun. One by one, until there's a ton!"
mail_complaint = "Quit limin'. You ain't givin' me a dime,  you slime. I'd rather use my summertime committing war crimes. Enough, enough, I won't give you any extra time."
